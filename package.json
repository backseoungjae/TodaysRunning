  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.21",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:database": "node --test scripts/testDatabase.cjs",
    "test:home": "node --test scripts/testHome.cjs",
    "test:permissions": "node --test scripts/testLocationPermissions.cjs",
    "test:gps": "node --test scripts/testGps.cjs",
    "test:run-store": "node --test scripts/testRunStore.cjs",
    "test:run-metrics": "node --test scripts/testRunMetrics.cjs",
    "test:run-map": "node --test scripts/testRunMap.cjs",
    "test:background-location": "node --test scripts/testBackgroundLocation.cjs",
    "test:run-lifecycle": "node --test scripts/testRunLifecycle.cjs",
    "test:activity": "node --test scripts/testActivity.cjs",
    "test:training-integration": "node --test scripts/testTrainingIntegration.cjs",
    "test:splits": "node --test scripts/testSplits.cjs",
    "test:personal-records": "node --test scripts/testPersonalRecords.cjs",
    "test": "node --test scripts/test*.cjs",
    "check:config": "node scripts/checkExpoConfig.cjs",
    "qa": "npm run typecheck && npm run lint && npm test && npm run check:config",
    "test:build-config": "node --test scripts/testBuildConfig.cjs",
    "test:device": "maestro test .maestro/run-lifecycle.yaml",
    "build:development": "npx eas-cli@latest build --profile development",
    "build:preview": "npx eas-cli@latest build --profile preview"
  },
  "private": true
}
